generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  mobile          String    @unique
  role            String    @default("ORGANIZER") // ORGANIZER | SUPPLIER | ADMIN
  name            String?
  email           String?
  // bcrypt hash; only set for ADMIN accounts (dashboard email/password login)
  passwordHash    String?
  gender          String?
  dob             String?
  // Organizer-specific
  businessName    String?
  companyName     String?
  businessType    String?
  city            String?
  address         String?
  gst             String?
  // Stored as "<userId>/<file>" under PROFILE_UPLOAD_DIR/profile-photos
  profilePhoto    String?
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  // FCM push token
  fcmToken        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens     RefreshToken[]
  events            Event[]
  supplierProfile   SupplierProfile?
  notifications     Notification[]
  emailVerification EmailVerification?
}

model SupplierProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aadhaarFrontUrl    String?
  aadhaarBackUrl     String?
  panCardUrl         String?
  selfieUrl          String?
  kycStatus          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  kycRejectionReason String?
  kycSubmittedAt     DateTime?
  kycApprovedAt      DateTime?
  walletBalance      Float     @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  enrollments       Enrollment[]
  transactions      WalletTransaction[]
  backupAssignments BackupAssignment[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Otp {
  id        String   @id @default(cuid())
  mobile    String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Organizer's event request submitted to Vizhaa
model Event {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  name             String
  type             String
  location         String
  // Precise venue chosen on the map (all optional so older events stay valid)
  locationName     String?
  formattedAddress String?
  city             String?
  state            String?
  pincode          String?
  latitude         Float?
  longitude        Float?
  placeId          String?
  date             String
  inTime           String
  outTime          String
  menCount         Int      @default(0)
  womenCount       Int      @default(0)
  suppliers        Int
  dressCode        String
  services         String[]
  costPerHead      Float
  totalCost        Float
  advancePaid      Float
  // PENDING → APPROVED → IN_PROGRESS → COMPLETED, or REJECTED (set by the admin panel)
  status           String   @default("PENDING")
  adminNotes       String?
  progress         Float    @default(0)
  approvedAt       DateTime?
  // Live tracking: when each fixed step was reached (null = not yet)
  supplierAssignedAt DateTime?
  suppliersArrivedAt DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  // On-site leads assigned by the admin
  managerName      String?
  managerPhone     String?
  supervisorName   String?
  supervisorPhone  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  eventPost EventPost?
  payments  Payment[]

  @@index([latitude, longitude])
}

// One row per verified Razorpay payment. The unique payment id makes event
// creation idempotent: retrying verification can never create a second event.
model Payment {
  id                String   @id @default(cuid())
  razorpayPaymentId String   @unique
  razorpayOrderId   String?
  userId            String
  eventId           String
  event             Event    @relation(fields: [eventId], references: [id])
  amount            Float
  purpose           String // ADVANCE | BALANCE
  isTest            Boolean  @default(false)
  // Kept in sync by the Razorpay webhook: captured | authorized | refunded
  status            String   @default("captured")
  createdAt         DateTime @default(now())

  @@index([eventId])
}

// Admin-published event post visible to KYC-approved suppliers
model EventPost {
  id                  String    @id @default(cuid())
  eventId             String    @unique
  event               Event     @relation(fields: [eventId], references: [id])
  menRequired         Int
  womenRequired       Int
  enrolledMen         Int       @default(0)
  enrolledWomen       Int       @default(0)
  payPerPerson        Float
  reportingTime       String
  uniformRequirements String
  cancellationHours   Int       @default(48)
  penaltyPercent      Int       @default(50)
  status              String    @default("OPEN") // OPEN | FILLED | COMPLETED | CANCELLED
  isPublished         Boolean   @default(false)
  publishedAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  enrollments       Enrollment[]
  backupAssignments BackupAssignment[]
  notifications     Notification[]
}

model Enrollment {
  id             String          @id @default(cuid())
  supplierId     String
  supplier       SupplierProfile @relation(fields: [supplierId], references: [id])
  eventPostId    String
  eventPost      EventPost       @relation(fields: [eventPostId], references: [id])
  status         String          @default("ENROLLED") // ENROLLED | CANCELLED | ATTENDED | NO_SHOW
  enrolledAt     DateTime        @default(now())
  cancelledAt    DateTime?
  penaltyApplied Boolean         @default(false)
  penaltyAmount  Float           @default(0)
  attended       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  transactions     WalletTransaction[]
  backupAssignment BackupAssignment?

  @@unique([supplierId, eventPostId])
}

model WalletTransaction {
  id           String          @id @default(cuid())
  supplierId   String
  supplier     SupplierProfile @relation(fields: [supplierId], references: [id])
  amount       Float
  type         String // CREDIT | DEBIT
  reason       String // EVENT_PAYMENT | PENALTY | WITHDRAWAL | REFUND
  enrollmentId String?
  enrollment   Enrollment?     @relation(fields: [enrollmentId], references: [id])
  status       String          @default("COMPLETED")
  note         String?
  createdAt    DateTime        @default(now())
}

model BackupAssignment {
  id              String          @id @default(cuid())
  supplierId      String
  supplier        SupplierProfile @relation(fields: [supplierId], references: [id])
  eventPostId     String
  eventPost       EventPost       @relation(fields: [eventPostId], references: [id])
  enrollmentId    String?         @unique
  enrollment      Enrollment?     @relation(fields: [enrollmentId], references: [id])
  assignedByAdmin String
  status          String          @default("ASSIGNED") // ASSIGNED | COMPLETED
  note            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Notification {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String
  type        String
  eventPostId String?
  eventPost   EventPost? @relation(fields: [eventPostId], references: [id])
  data        Json?
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

// Pending email verification code (one per user). Only a keyed hash of the
// code is stored.
model EmailVerification {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  codeHash    String
  expiresAt   DateTime
  attempts    Int      @default(0)
  // Send throttling: sends within the current hourly window
  sendCount   Int      @default(0)
  windowStart DateTime @default(now())
  lastSentAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
