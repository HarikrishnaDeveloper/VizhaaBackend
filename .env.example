PORT=5000

# Local Docker Postgres (docker compose up -d db). Inside Docker the compose file overrides this.
DATABASE_URL=postgresql://vizhaa:vizhaa123@localhost:5433/vizhaa_db

# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-long-random-secret-here

# Folder for uploaded profile photos (a "profile-photos" subfolder is created inside)
PROFILE_UPLOAD_DIR=

# Brevo SMTP for email verification codes
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
# Verified sender in Brevo, e.g. "Vizhaa <no-reply@yourdomain.com>"
EMAIL_FROM=

# Geoapify key for place search / geocoding (server-side only, never in the app)
GEOAPIFY_API_KEY=

# Development only: accept the app's simulated payments (ignored when NODE_ENV=production)
ALLOW_TEST_PAYMENTS=false

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Dashboard → Webhooks → secret for POST /api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Super-admin dashboard login (seeded with: npx prisma db seed)
ADMIN_EMAIL=admin@vizhaa.com
ADMIN_PASSWORD=
ADMIN_MOBILE=9999999999
